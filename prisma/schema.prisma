generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// USER -> MOVIE (1:N) -> WATCHLIST

model User {
  id String @id @default(uuid())
  email String @unique
  name String
  password String
  createdAt DateTime @default(now())
}

model Movie {
  id String @id @default(uuid())
  tittle String
  overview String?
  releaseYear Int
  genres String[] @default([])
  runtime Int?
  posterUrl String?
  createdBy String
  created DateTime @default(now())

  creator User @relation("MovieCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  WatchlistItems Watch

}

model WatchListItem {
  id String @id @default(uuid())
  userId String
  movieId String
  status WatchlistStatus @default(planned)
  rating Int?
  notes String?
  createdAt DateTime @default(now())
  updateAt DateTime @default(now())

  //relation
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum WatchlistStatus {
  planned
  watching
  completed
  dropped
}